{
  "schema": "atlas.phase7.combat_sequence_binding.v1",
  "source_sequence_version": 1,
  "principle": "Existing CombatDirector events are authoritative. Family clips are time-warped between them.",
  "segments": [
    {
      "clip_range": [
        0.0,
        0.24
      ],
      "director_events": [
        "LOCK_CONTROLS",
        "PREPARE_ATTACK",
        "MOVE_ATTACKER"
      ],
      "purpose": "anticipation"
    },
    {
      "clip_range": [
        0.24,
        0.82
      ],
      "director_events": [
        "MOVE_ATTACKER",
        "APPLY_HIT",
        "APPLY_STATUS"
      ],
      "purpose": "action and dynamic hit windows",
      "multi_hit_rule": "Distribute the family action loop across actual sequence.hits; do not invent damage."
    },
    {
      "clip_range": [
        0.82,
        1.0
      ],
      "director_events": [
        "RETURN_ATTACKER",
        "UNLOCK_CONTROLS"
      ],
      "purpose": "recovery"
    }
  ],
  "miss_binding": {
    "director_events": [
      "ATTACK_START",
      "MISS_REACTION",
      "COUNTER_HIT",
      "RETURN_ATTACKER"
    ],
    "clip": "<family>.miss",
    "counter_rule": "Universal hurt clip may interrupt family miss after COUNTER_HIT."
  },
  "critical_binding": {
    "quality_id": "critico",
    "clip": "<family>.critical",
    "hitstop_source": "sequence.hits[].hitstop",
    "camera_source": "sequence.camera"
  },
  "non_mutation_rules": [
    "No family clip changes hitCount.",
    "No family clip changes damageParts.",
    "No family clip applies status.",
    "No projectile event decides whether the shot lands."
  ]
}